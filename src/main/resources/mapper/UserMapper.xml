<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mybatis.mapper.UserMapper">

    <!-- sql 片段 -->
    <sql id="select">
        SELECT id, username, password, name, gender, age, card, phone, money, role
        FROM user
    </sql>

    <!-- 查询所有用户 -->
    <select id="findAll" resultType="User">
        <include refid="select"/>
        ORDER BY id DESC
    </select>

    <!-- 统计用户总数 -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM user
    </select>

    <!-- 根据用户名和密码查询用户（储户登录） -->
    <select id="findByUsernameAndPassword" parameterType="User" resultType="User">
        <include refid="select"/>
        WHERE username = #{username}
        AND password = #{password}
    </select>

    <!-- 根据ID查询用户 -->
    <select id="findById" parameterType="int" resultType="User">
        <include refid="select"/>
        WHERE id = #{id}
    </select>

    <!-- 根据用户名查询用户 -->
    <select id="findByUsername" parameterType="string" resultType="User">
        <include refid="select"/>
        WHERE username = #{username}
    </select>

    <!-- 根据银行卡号查询用户 -->
    <select id="findByCard" parameterType="string" resultType="User">
        <include refid="select"/>
        WHERE card = #{card}
    </select>

    <!-- 新增用户 -->
    <insert id="insert" parameterType="User">
        INSERT INTO user
        (username, password, name, gender, age, card, phone, money, role)
        VALUES
        (#{username}, #{password}, #{name}, #{gender}, #{age}, #{card}, #{phone}, #{money}, #{role})
    </insert>

    <!-- 根据ID删除用户 -->
    <delete id="deleteById" parameterType="int">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!-- 动态更新用户信息 -->
    <update id="update" parameterType="User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="name != null">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="age != null">age = #{age},</if>
            <if test="card != null">card = #{card},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="money != null">money = #{money},</if>
            <if test="role != null">role = #{role},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 条件搜索用户 -->
    <select id="search" parameterType="User" resultType="User">
        <include refid="select"/>
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="age != null and age != 0">
                AND age >= #{age}
            </if>
            <if test="money != null">
                AND money >= #{money}
            </if>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!-- 更新用户余额 -->
    <update id="updateMoney" parameterType="User">
        UPDATE user SET money = #{money} WHERE id = #{id}
    </update>

    <!-- 修改密码 -->
    <update id="updatePassword" parameterType="User">
        UPDATE user SET password = #{password} WHERE id = #{id}
    </update>

    <!-- 分页查询 -->
    <select id="findByPage" resultType="User">
        <include refid="select"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{size}
    </select>

</mapper>
