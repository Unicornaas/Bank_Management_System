<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mybatis.mapper.UserVipMapper">

    <resultMap id="userVipMap" type="UserVip">
        <id property="id" column="id"/>
        <result property="levelName" column="level_name"/>
        <result property="levelCode" column="level_code"/>
        <result property="minBalance" column="min_balance"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="color" column="color"/>
        <result property="icon" column="icon"/>
        <result property="benefits" column="benefits"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <select id="findAll" resultMap="userVipMap">
        SELECT id, level_name, level_code, min_balance, discount_rate, color, icon, benefits, sort_order
        FROM user_vip
        ORDER BY sort_order
    </select>

    <!-- 根据余额匹配VIP等级：余额 >= min_balance 中最大的那条 -->
    <select id="findByBalance" parameterType="double" resultMap="userVipMap">
        SELECT id, level_name, level_code, min_balance, discount_rate, color, icon, benefits, sort_order
        FROM user_vip
        WHERE min_balance &lt;= #{balance}
        ORDER BY min_balance DESC
        LIMIT 1
    </select>

</mapper>
