<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fjut.mybatis.mapper.BranchMapper">

    <resultMap id="branchMap" type="Branch">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="managerName" column="manager_name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="select">
        SELECT id, name, address, phone, manager_name, description, status, create_time
        FROM branch
    </sql>

    <select id="findAll" resultMap="branchMap">
        <include refid="select"/>
        ORDER BY id ASC
    </select>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM branch
    </select>

    <select id="findById" parameterType="int" resultMap="branchMap">
        <include refid="select"/>
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="Branch">
        INSERT INTO branch (name, address, phone, manager_name, description, status)
        VALUES (#{name}, #{address}, #{phone}, #{managerName}, #{description}, #{status})
    </insert>

    <update id="update" parameterType="Branch">
        UPDATE branch
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="address != null">address = #{address},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="managerName != null">manager_name = #{managerName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="int">
        DELETE FROM branch WHERE id = #{id}
    </delete>

    <select id="search" parameterType="Branch" resultMap="branchMap">
        <include refid="select"/>
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="address != null and address != ''">
                AND address LIKE CONCAT('%', #{address}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id ASC
    </select>

    <select id="findByPage" resultMap="branchMap">
        <include refid="select"/>
        ORDER BY id ASC
        LIMIT #{offset}, #{size}
    </select>

</mapper>
